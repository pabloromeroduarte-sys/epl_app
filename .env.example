# Copia a .env y completa ( .env no se sube a git )
DB_HOST=localhost
DB_NAME=epleague
DB_USER=root
DB_PASS=

APP_URL=http://localhost/elitepadelleague
APP_ENV=local

# El MCP remoto usa APP_URL para publicar sus endpoints OAuth.
# En producción: https://epleague.cl

# Mismo valor que en GitHub Secrets y en el VPS (deploy_webhook.php)
DEPLOY_TOKEN=

# Web Push (notificaciones del navegador)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google reCAPTCHA v3 — registro y recuperar contraseña
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5
