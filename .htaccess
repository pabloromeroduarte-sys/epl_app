Options -Indexes
RewriteEngine On

# ── HTTPS en producción ───────────────────────────────────────────────────────
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Bloquear archivos sensibles ───────────────────────────────────────────────
<FilesMatch "^\.env|composer\.json|package\.json|package-lock\.json|tailwind\.config\.js">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|sh|bak|zip)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear carpeta migration y node_modules en producción
RewriteRule ^migration/     - [F,L]
RewriteRule ^node_modules/  - [F,L]

# ── Caché HTTP para assets estáticos ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Imágenes — 1 año (nombre incluye versión via ?v=mtime)
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/jpg         "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/gif         "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  # CSS y JS — 1 mes (versión via ?v=filemtime)
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript   "access plus 1 month"
  # Fuentes
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType font/woff         "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cache estático para assets (con ?v= en CSS/JS, browsers los revalidan)
  <FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Bloquear carpeta migration ────────────────────────────────────────────────

RewriteBase /elitepadelleague/

# No reescribir archivos o directorios existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rutas limpias (opcional)
# RewriteRule ^jugadores/([0-9]+)$ jugador_perfil.php?id=$1 [L,QSA]
